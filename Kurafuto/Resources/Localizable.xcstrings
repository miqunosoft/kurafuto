      }
    },
    "The certificate is self-signed. Verify the fingerprint and trust it?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zertifikat ist selbstsigniert. Fingerabdruck prüfen und dem Zertifikat vertrauen?"
          }
        },
        "ja" : {
          "stringUnit" : {
