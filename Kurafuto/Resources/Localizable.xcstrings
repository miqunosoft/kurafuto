    "Your panel account is not allowed to do this. Ask the panel's admin for access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Panel-Konto darf das nicht. Bitte den Admin des Panels um Zugriff."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのパネルアカウントにはこの操作の権限がありません。パネルの管理者にアクセス権を依頼してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的面板账户无权执行此操作。请向面板管理员申请权限。"
          }
        }
      }
    },
    "Your servers. In your pocket." : {
      "localizations" : {
