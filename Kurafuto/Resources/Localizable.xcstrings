          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，切换面板"
          }
        }
      }
    },
    "%@: backup schedules that use it stop running. Archives stay on the panel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Backup-Zeitpläne, die diese Konfiguration nutzen, laufen nicht mehr. Die Archive bleiben auf dem Panel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: この構成を使うバックアップのスケジュールは実行されなくなります。アーカイブはパネルに残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：使用此配置的备份计划任务将停止运行。归档会保留在面板上。"
          }
        }
      }
    },
    "%@: the server stops and the archive is unpacked over its current files. Files that are not in the archive stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Der Server wird gestoppt und das Archiv über die aktuellen Dateien entpackt. Dateien, die nicht im Archiv sind, bleiben erhalten."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: サーバーが停止し、アーカイブが現在のファイルに上書きして展開されます。アーカイブにないファイルはそのまま残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：服务器将停止，归档会解压并覆盖当前文件。不在归档中的文件将保留。"
          }
        }
      }
    },
    "%@: the server stops, its folder is emptied and the archive is unpacked. Everything that is not in the archive is lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Der Server wird gestoppt, sein Ordner geleert und das Archiv entpackt. Alles, was nicht im Archiv ist, geht verloren."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: サーバーが停止し、フォルダが空になってからアーカイブが展開されます。アーカイブにないものはすべて失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：服务器将停止，其文件夹会被清空，然后解压归档。不在归档中的所有内容都将丢失。"
          }
        }
      }
    },
