    "%@ and everything in it will be deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird mit dem gesamten Inhalt gelöscht."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」とその中身がすべて削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”及其中的所有内容都将被删除。"
          }
        }
      }
    },
    "%@ at %@" : {
      "comment" : "Schedule summary: an interval such as “Every 2 days”, then the time of day.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ um %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ at %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ can no longer sign in to the panel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann sich dann nicht mehr am Panel anmelden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はパネルにサインインできなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将无法再登录面板。"
          }
        }
      }
    },
    "%@ can only start after you accept the Minecraft End User License Agreement." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann erst starten, wenn du den Minecraft-Endbenutzer-Lizenzvertrag akzeptierst."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は Minecraft エンドユーザーライセンス契約に同意するまで起動できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你需要先接受 Minecraft 最终用户许可协议，%@ 才能启动。"
          }
        }
      }
    },
