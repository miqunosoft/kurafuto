    "Both remove the server's schedules. Removing keeps its folder and backups on the panel's disk; deleting erases them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beides entfernt die Zeitpläne des Servers. „Vom Panel entfernen“ behält Ordner und Backups auf dem Datenträger des Panels, „Server und Dateien löschen“ löscht sie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらもサーバーのスケジュールを削除します。「パネルから除外」ではフォルダとバックアップがパネルのディスクに残り、「サーバーとファイルを削除」ではそれらも消去されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两者都会删除服务器的计划任务。“从面板移除”会将其文件夹和备份保留在面板磁盘上；“删除服务器和文件”则会将其清除。"
          }
        }
      }
    },
    "CPU" : {
      "shouldTranslate" : false
    },
    "CPU %@" : {
      "localizations" : {
