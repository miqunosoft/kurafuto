          }
        }
      }
    },
    "The file was changed on the panel after you opened it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wurde auf dem Panel geändert, nachdem du sie geöffnet hast."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは、開いた後にパネル上で変更されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你打开此文件后，它已在面板上被更改。"
          }
        }
      }
    },
    "The latest backup of one server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das neueste Backup eines Servers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 台のサーバーの最新のバックアップ。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单台服务器的最新备份。"
          }
        }
      }
    },
    "The name needs at least 2 characters and must not contain / \\ or #." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Name braucht mindestens 2 Zeichen und darf weder /, \\ noch # enthalten."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前は 2 文字以上にし、/ \\ # を含めないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名称至少需要 2 个字符，且不能包含 /、\\ 或 #。"
          }
        }
      }
    },
    "The panel creates the archive in the background. Pull down to refresh the list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Panel erstellt das Archiv im Hintergrund. Ziehe nach unten, um die Liste zu aktualisieren."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パネルがバックグラウンドでアーカイブを作成します。下に引くとリストを更新できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板正在后台创建归档。下拉即可刷新列表。"
          }
        }
      }
    },
    "The panel kills the server when it has not stopped within the shutdown timeout." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Panel beendet den Server sofort, wenn er nicht innerhalb des Stopp-Zeitlimits gestoppt ist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止のタイムアウトまでにサーバーが停止しない場合、パネルが強制終了します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果服务器在停止超时内仍未停止，面板会将其强制终止。"
          }
        }
      }
    },
    "The panel rejected this token." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Panel hat dieses Token abgelehnt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パネルがこのトークンを拒否しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板拒绝了此令牌。"
          }
        }
      }
    },
    "The panel restores %@ in the background. Start the server again when it is done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Panel stellt %@ im Hintergrund wieder her. Starte den Server wieder, wenn es fertig ist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パネルがバックグラウンドで %@ を復元します。完了したらサーバーを再び起動してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板正在后台恢复 %@。完成后请重新启动服务器。"
          }
        }
      }
    },
    "The panel saves new role names in lowercase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Panel speichert neue Rollennamen in Kleinbuchstaben."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パネルは新しいロール名を小文字で保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板会以小写形式保存新角色名称。"
          }
        }
      }
    },
    "The panel sent a test message to “%@”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Panel hat eine Testnachricht an „%@“ gesendet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パネルが「%@」にテストメッセージを送信しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板已向“%@”发送测试消息。"
          }
        }
      }
    },
    "The port must be between 1 and 65535." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Port muss zwischen 1 und 65535 liegen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポートは 1〜65535 の範囲で指定してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端口必须介于 1 到 65535 之间。"
          }
        }
      }
    },
    "The server folder stays on the panel's disk. Type “%@” to confirm." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
