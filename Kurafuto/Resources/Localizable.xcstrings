    "A file with this name is already in this folder. The upload replaces it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Ordner gibt es bereits eine Datei mit diesem Namen. Der Upload ersetzt sie."
          }
        },
        "ja" : {
