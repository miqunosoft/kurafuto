      }
    },
    "Your session on this panel has ended, for example because it expired or all sessions were signed out. Sign in again to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Sitzung auf diesem Panel ist beendet, zum Beispiel weil sie abgelaufen ist oder alle Sitzungen abgemeldet wurden. Melde dich erneut an, um fortzufahren."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパネルでのセッションは終了しました（有効期限が切れた、すべてのセッションがサインアウトされた、など）。続けるにはもう一度サインインしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在此面板上的会话已结束，例如会话已过期或所有会话均已退出。请重新登录以继续。"
          }
        }
      }
    },
    "Your session on this panel has ended. Sign in again to continue." : {
