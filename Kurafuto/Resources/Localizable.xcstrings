        }
      }
    },
    "Only superusers can see and change which servers a role covers. Saving keeps them as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Superuser können sehen und ändern, für welche Server eine Rolle gilt. Beim Speichern bleiben sie unverändert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロールの対象サーバーを表示・変更できるのはスーパーユーザーだけです。保存しても対象サーバーは変わりません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有超级用户才能查看和更改角色适用的服务器。保存时会保持不变。"
          }
        }
      }
    },
